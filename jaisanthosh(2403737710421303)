<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Advanced Music Player</title>

<style>
body {
  font-family: Arial;
  margin: 0;
  background: #0f2027;
  background: linear-gradient(to right, #2c5364, #203a43, #0f2027);
  color: white;
  text-align: center;
}

header {
  padding: 15px;
  font-size: 24px;
  font-weight: bold;
}


.player {
  width: 300px;
  margin: 30px auto;
  padding: 20px;
  background: #1e1e1e;
  border-radius: 15px;
  box-shadow: 0 0 20px rgba(0,0,0,0.5);
}


.player img {
  width: 100%;
  border-radius: 10px;
}


.title {
  margin: 10px 0;
  font-size: 18px;
}


.controls button {
  margin: 10px;
  padding: 10px;
  border: none;
  border-radius: 50%;
  background: #1db954;
  color: white;
  cursor: pointer;
  font-size: 16px;
}


.progress {
  width: 100%;
  height: 5px;
  background: #444;
  margin: 10px 0;
  border-radius: 5px;
  cursor: pointer;
}

.progress-bar {
  height: 5px;
  width: 0%;
  background: #1db954;
  border-radius: 5px;
}


.song-list {
  max-width: 400px;
  margin: auto;
  text-align: left;
}

.song {
  padding: 10px;
  border-bottom: 1px solid #444;
  cursor: pointer;
}

.song:hover {
  background: #333;
}
</style>
</head>

<body>

<header>🎧 Advanced Music Player</header>

<div class="player">
  <img id="cover" src="https://via.placeholder.com/300">
  <div class="title" id="title">Select a song</div>

  <div class="progress" onclick="setProgress(event)">
    <div class="progress-bar" id="progressBar"></div>
  </div>

  <div class="controls">
    <button onclick="prevSong()">⏮</button>
    <button onclick="togglePlay()">⏯</button>
    <button onclick="nextSong()">⏭</button>
  </div>
</div>

<div class="song-list" id="songList"></div>

<audio id="audio"></audio>

<script>
const songs = [
  {
    title: "Arabic Kuthu",
    src: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3",
    cover: "https://via.placeholder.com/300/1db954"
  },
  {
    title: "Munbe Vaa",
    src: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3",
    cover: "https://via.placeholder.com/300/ff4081"
  },
  {
    title: "Vaathi Coming",
    src: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-3.mp3",
    cover: "https://via.placeholder.com/300/2196f3"
  }
];

let currentIndex = 0;
const audio = document.getElementById("audio");


function loadSong(index) {
  const song = songs[index];
  document.getElementById("title").textContent = song.title;
  document.getElementById("cover").src = song.cover;
  audio.src = song.src;
}


function togglePlay() {
  if (audio.paused) audio.play();
  else audio.pause();
}


function nextSong() {
  currentIndex = (currentIndex + 1) % songs.length;
  loadSong(currentIndex);
  audio.play();
}


function prevSong() {
  currentIndex = (currentIndex - 1 + songs.length) % songs.length;
  loadSong(currentIndex);
  audio.play();
}


audio.addEventListener("timeupdate", () => {
  const progress = (audio.currentTime / audio.duration) * 100;
  document.getElementById("progressBar").style.width = progress + "%";
});


function setProgress(e) {
  const width = e.currentTarget.clientWidth;
  const clickX = e.offsetX;
  audio.currentTime = (clickX / width) * audio.duration;
}


function displaySongs() {
  const list = document.getElementById("songList");
  songs.forEach((song, index) => {
    const div = document.createElement("div");
    div.className = "song";
    div.textContent = song.title;
    div.onclick = () => {
      currentIndex = index;
      loadSong(index);
      audio.play();
    };
    list.appendChild(div);
  });
}

audio.addEventListener("ended", nextSong);

loadSong(currentIndex);
displaySongs();
</script>

</body>
</html>
